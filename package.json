{
  "name": "shopping-specials",
  "version": "1.0.2",
  "private": true,
  "description": "Australian Supermarket Specials iOS App (Woolworths, Coles & ALDI) + Companion Web Scraper/Catalogue Backend",
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "sync": "npm --prefix server run sync",
    "app": "npm --prefix app start",
    "app:ios": "npm --prefix app run ios",
    "app:web": "npm --prefix app run web",
    "build:ipa": "npm --prefix app run build:ipa:eas",
    "build:ipa:store": "npm --prefix app run build:ipa:store",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "install:all": "npm --prefix server install && npm --prefix app install"
  }
}

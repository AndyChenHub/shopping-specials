{
  "expo": {
    "name": "Aussie Specials",
    "slug": "aussie-specials",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.com.shoppingspecials.app",
      "buildNumber": "4",
      "infoPlist": {
        "CFBundleDisplayName": "Aussie Specials",
        "RCTAsyncStorageExcludeFromBackup": false,
        "NSLocationWhenInUseUsageDescription": "Aussie Specials uses your location to find nearby Woolworths, Coles, ALDI and IGA stores and check local stock availability.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "au.com.shoppingspecials.app",
      "versionCode": 4,
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#119F99",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Aussie Specials",
      "shortName": "Aussie",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
